# Google Cloud credentials (for local development only — not needed on Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# GCS bucket for VPN data (peers.json, server-keys.json)
GCS_BUCKET=your-project-id-vpn-data

# GCE VM running WireGuard
GCE_HOST=your-vm-external-ip
GCE_USER=ubuntu

# WireGuard settings
WG_INTERFACE=wg0
SERVER_PORT=51820
# Leave empty to use GCE_HOST (the VPN VM). Do not use the Cloud Run website.
SERVER_ENDPOINT=
VPN_SUBNET=10.8.0

# Secret Manager secret names
SSH_KEY_SECRET=vpn-ssh-private-key
API_KEY_SECRET=vpn-api-secret

# Server port (Cloud Run sets PORT automatically)
PORT=8080

# Email login needs APP_URL and SESSION_ENCRYPTION_KEY; no client registration.
# Google login and SMTP notifications additionally need PROXY_CLIENT_ID/SECRET.
# Only xiangenhu@gmail.com receives the administrator role.
APP_URL=https://vpn.skoonline.org
PROXY_CLIENT_ID=xhuvpn
# Set these securely in the deployment, never commit real values:
PROXY_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# Deployment script defaults: existing Secret Manager resource names, not values.
PROXY_SECRET_NAME=xhuvpn-proxy-secret
SESSION_SECRET_NAME=xhuvpn-session-key
