{
  "name": "wireguard-vpn-manager",
  "version": "2.0.0",
  "description": "WireGuard VPN manager — Cloud Run + GCS + GCE VM",
  "main": "server.js",
  "scripts": {
    "test:oauth-infrastructure": "node --test oauth-infrastructure.test.mjs",
    "build:extensions": "node scripts/build-extensions.js",
    "test:proxy": "npm --prefix proxy test",
    "start": "node --import ./oauth-infrastructure.mjs server.js",
    "dev": "nodemon --exec \"node --import ./oauth-infrastructure.mjs\" server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^5.0.1",
    "@google-cloud/storage": "^7.7.0",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "fflate": "^0.8.3",
    "node-ssh": "^13.1.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

